{
	"name": "mensculture",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"next": "16.4.5",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "pnpm@11.11.0"
}
