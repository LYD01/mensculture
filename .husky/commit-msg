if ! npx --no -- commitlint --edit "$1"; then
  echo ""
  echo "=========================================="
  echo "  COMMIT MESSAGE DOES NOT FOLLOW"
  echo "  CONVENTIONAL COMMITS FORMAT"
  echo "=========================================="
  echo ""
  echo "  Your commit message must match:"
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "  Example:"
  echo "    feat(home): add services section to one-pager"
  echo "    fix(admin): validate promo code dates"
  echo "    docs(readme): update setup instructions"
  echo ""
  echo "  Allowed types:"
  echo "    feat      — A new feature"
  echo "    fix       — A bug fix"
  echo "    docs      — Documentation only changes"
  echo "    style     — Formatting, missing semicolons, etc (no code change)"
  echo "    refactor  — Code change that neither fixes a bug nor adds a feature"
  echo "    perf      — A code change that improves performance"
  echo "    test      — Adding or correcting tests"
  echo "    build     — Changes to build system or external dependencies"
  echo "    ci        — Changes to CI configuration files and scripts"
  echo "    chore     — Other changes that don't modify src or test files"
  echo "    revert    — Reverts a previous commit"
  echo ""
  echo "  Scope is optional. Subject must be lowercase,"
  echo "  imperative tense, and no period at the end."
  echo "=========================================="
  echo ""
  exit 1
fi
