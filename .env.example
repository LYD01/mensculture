# Neon Postgres (provided by the Vercel Neon integration; `vercel env pull .env.local`)
DATABASE_URL=
# Direct connection used by drizzle-kit (`pnpm db:push`)
DATABASE_URL_UNPOOLED=

# Admin area (/admin). Long passphrase, 16+ characters.
ADMIN_PASSWORD=
# Signs the admin session cookie. 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Optional. Public site URL for metadata, sitemap, and JSON-LD (e.g. https://mensculture.com.au).
# Defaults to https://{VERCEL_PROJECT_PRODUCTION_URL} on Vercel, else http://localhost:3000.
SITE_URL=
